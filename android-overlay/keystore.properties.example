# 复制成 keystore.properties 后填自己的值（keystore.properties 已被 .gitignore 排除）
#
# 生成密钥（有效期 10000 天，PKCS12 要求 store/key 口令一致）：
#   keytool -genkeypair -v -keystore android-overlay/leonmusic-release.jks \
#     -alias leonmusic -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass <你的口令> -keypass <你的口令> \
#     -dname "CN=LeonMusic, OU=Leon, O=LeonMusic, L=Shanghai, ST=Shanghai, C=CN"
#
# 填好本文件后执行 `python android-overlay/apply.py`，再 `npm run android:build`。
storeFile=leonmusic-release.jks
storePassword=CHANGE_ME
keyAlias=leonmusic
keyPassword=CHANGE_ME
